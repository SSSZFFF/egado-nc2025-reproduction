##########################################################
####### Base script for Topology Optimization ############
####### Copyright (C) - FiOWIN Lab @ Fudan University ####
##########################################################


switchtolayout;
selectall;
delete;


#########################
#### Initialization #####
#########################
num_in_wg=2;
num_out_wg=1;
out_wg_width=900e-9;
in_wg_width=500e-9;
in_wg_pitch=1.3e-6;
opt_size_x=3.6e-6;
opt_size_y=3.6e-6;
lam_c=1550e-9;
mode_num=2;
wavelength_span=40e-9;
in_mode_list=[1,1];
out_mode_list=[1,2];

dx = 20e-9;
size_x = opt_size_x+1e-6;
size_y = opt_size_y+1e-6;
fdtd_zspan = 2e-6;
wg_thickness = 220e-9;
cladding_thickness = 10e-6;


#########################
## Material Definition ##
#########################
n_wg=3.476379552649523;
n_bg=1.444002301177903;
self_define_materials=true;
if (self_define_materials){
    addmaterial("Dielectric");
    setmaterial("New material 1", "Refractive Index", n_bg);
    setmaterial("New material 1", "color", [0,255,255,255]);
    setmaterial("New material 1", "Mesh Order", 2);
    setmaterial("New material 1", "name", "n_bg");
    addmaterial("Dielectric");
    setmaterial("New material 1", "Refractive Index", n_wg);
    setmaterial("New material 1", "color", [170,0,0,255]);
    setmaterial("New material 1", "Mesh Order", 2);
    setmaterial("New material 1", "name", "n_wg");
}


#########################
###### add cladding #####
#########################
addrect;
set('name','cladding');
set('x',0);
set('x span',opt_size_x + 7e-6);
set('y',0);
set('y span',opt_size_y + 7e-6);
set('z',0);
set('z span',cladding_thickness);
set('material',"n_bg");


#########################
####### add IN WG #######
#########################
for (i=1:num_in_wg){
    addrect;
    set('name','input wg '+num2str(i));
    set('x min',-size_x);
    set('x max',-opt_size_x/2);
    # This term should be determined manually according to different functionalities of devices
    # set('y',opt_size_y/2-0.5*(1/num_in_wg)*opt_size_y-(1/num_in_wg)*(i-1)*opt_size_y);
    # in_wg_pitch==0 keeps the original evenly-spread formula; a positive value
    # places the inputs symmetrically about y=0 with that exact centre-to-centre pitch.
    if (in_wg_pitch == 0) {
        y_in_wg = opt_size_y/2-0.5*in_wg_width-(1/(num_in_wg-1))*(i-1)*(opt_size_y-in_wg_width);
    } else {
        y_in_wg = 0.5*(num_in_wg-1)*in_wg_pitch-(i-1)*in_wg_pitch;
    }
    set('y',y_in_wg);
    set('y span',in_wg_width);
    set('z',0);
    set('z span',wg_thickness);
    set('material',"n_wg");
}


#########################
###### add OUT WG #######
#########################
for (i=1:num_out_wg){
    addrect;
    set('name','output wg'+num2str(i));
    set('x min',opt_size_x/2);
    set('x max',size_x);
    set('y',0.5*opt_size_y-0.5*out_wg_width);
    set('y span',out_wg_width);
    set('z',0);
    set('z span',wg_thickness);
    set('material',"n_wg");
}


#########################
###### add Source #######
#########################
for(i=1:mode_num) {
    addmode;
    set("name","Source_TE_mode"+num2str(i)+"_1550");
    set('direction','Forward');
    set('injection axis','x-axis');
    # set('y',opt_size_y/2-0.5*(1/num_in_wg)*opt_size_y-(1/num_in_wg)*(i-1)*opt_size_y);
    if (in_wg_pitch == 0) {
        y_in_wg = opt_size_y/2-0.5*in_wg_width-(1/(num_in_wg-1))*(i-1)*(opt_size_y-in_wg_width);
    } else {
        y_in_wg = 0.5*(num_in_wg-1)*in_wg_pitch-(i-1)*in_wg_pitch;
    }
    set('y',y_in_wg);
    set('y span',in_wg_width+1e-6);
    set('x',-size_x/2+0.2e-6);
    set('z',0);
    set('z span',fdtd_zspan);
    set('center wavelength',lam_c);
    set('wavelength span', wavelength_span);
    set("mode selection", "user select");
    set("selected mode number", in_mode_list(i));
}


#########################
####### add FDTD ########
#########################
addfdtd;
set('dimension','3D');
set('background material',"n_bg");
set('mesh accuracy',3);
set('x min',-size_x/2);
set('x max',size_x/2);
set('y min',-size_y/2);
set('y max',size_y/2);
set('z',0);
set('z span',fdtd_zspan);
set('simulation time',5000e-15);
set('auto shutoff min',1e-5);
set('force symmetric z mesh', 1);
set("z min bc","Symmetric");


#########################
## add adjoint region ###
#########################
addpower;
set('name','opt_fields');
set('monitor type','3D');
set('x',0);
set('x span',opt_size_x);
set('y min',-opt_size_y/2);
set('y max',opt_size_y/2);
set('z',0);
set('z span',wg_thickness);


#########################
######## add FOM ########
#########################
for(i=1:mode_num) {
    addpower;
    set('name',"fom"+num2str(i));
    set('monitor type','2D X-normal');
    set('x', size_x/2-0.2e-6);
    # This term should be determined manually according to different functionalities of devices
    set('y',0.5*opt_size_y-0.5*out_wg_width);
    set('y span',out_wg_width+1e-6);
    set('z',0);
    set('z span',fdtd_zspan);
}


#########################
#### add DESIGN MESH ####
#########################
# Pin the in-plane AND out-of-plane mesh over the optimisation region to a
# fixed 20 nm instead of letting conformal refinement decide it.  Without this
# the design-region mesh follows the permittivity pattern, so the discrete
# problem the optimiser sees drifts from iteration to iteration, and it does
# not match the fixed mesh that the EG-ATD / DBS phases (base_EGA2D.lsf and
# base_DBS.lsf) use on the very same region.
addmesh;
set('name','design_mesh');
set('override x mesh',true);
set('override y mesh',true);
set('override z mesh',true);
set('dx',20e-9);
set('dy',20e-9);
set('dz',20e-9);
set('x',0);
set('x span',opt_size_x);
set('y',0);
set('y span',opt_size_y);
set('z',0);
set('z span',wg_thickness);


#########################
#### add SOURCE MESH ####
#########################
# One thin slab per mode source, mirroring the fom_mesh treatment at the other
# end of the device, so the mode profile injected at the input is computed on a
# fixed transverse mesh as well.
for(i=1:mode_num) {
    addmesh;
    set('name','source_mesh'+num2str(i));
    if (in_wg_pitch == 0) {
        y_in_wg = opt_size_y/2-0.5*in_wg_width-(1/(num_in_wg-1))*(i-1)*(opt_size_y-in_wg_width);
    } else {
        y_in_wg = 0.5*(num_in_wg-1)*in_wg_pitch-(i-1)*in_wg_pitch;
    }
    set('override x mesh',true);
    set('override y mesh',true);
    set('override z mesh',true);
    set('dx',20e-9);
    set('dy',20e-9);
    set('dz',20e-9);
    set('x', -size_x/2+0.2e-6);
    set('x span', 2*dx);
    set('y', y_in_wg);
    set('y span', in_wg_width+1e-6);
    set('z',0);
    set('z span',1.2e-6);
}


#########################
##### add FOM MESH ######
#########################
for(i=1:num_out_wg){
    addmesh;
    set('name','fom_mesh');
    set('override x mesh',true);
    set('dx',20e-9);
    set('override y mesh',false);
    set('override z mesh',false);
    set('x', size_x/2-0.2e-6);
    set('x span',2*dx);
    # This term should be determined manually according to different functionalities of devices
    set('y',0.5*opt_size_y-0.5*out_wg_width);
    set('y span',out_wg_width+1e-6);
    set('z',0);
    set('z span',1.2e-6);
}


#########################
###### add Index ########
#########################
addindex;
set('monitor type','3D');
set('name','global_index');
set('x min',-size_x/2);
set('x max',size_x/2);
set('y min',-size_y/2);
set('y max',size_y/2);
set('z',0);
set('z span',fdtd_zspan);

# Portable forward-only comparison additions, 2026-10-11.
# Before eval(), Python must putv full_gds_filename, full_gds_cellname, source_index.
# This template has NOT been run in Lumerical on the preparation computer.
# Full GDS includes the shared external lead geometry and the complete Si region.
# Only WGF_COR 13/1 is imported as silicon. CLD / DEV remain fabrication drawings.
select("input wg 1"); delete;
select("input wg 2"); delete;
select("output wg1"); delete;
select("opt_fields"); delete;
select("global_index"); delete;
setmaterial("n_wg", "Mesh Order", 1);
gdsimport(full_gds_filename, full_gds_cellname, "13:1", "n_wg", -110e-9, 110e-9);

setnamed("fom_mesh", "override y mesh", true);
setnamed("fom_mesh", "override z mesh", true);
setnamed("fom_mesh", "dy", 20e-9);
setnamed("fom_mesh", "dz", 20e-9);
setnamed("FDTD", "x min bc", "PML");
setnamed("FDTD", "x max bc", "PML");
setnamed("FDTD", "y min bc", "PML");
setnamed("FDTD", "y max bc", "PML");
setnamed("FDTD", "z max bc", "PML");
setnamed("FDTD", "z min bc", "Symmetric");
setglobalmonitor("frequency points", 11);

for(i=1:mode_num) {
    setnamed("Source_TE_mode"+num2str(i)+"_1550", "enabled", (i==source_index));
    setnamed("fom"+num2str(i), "override global monitor settings", false);
    addmodeexpansion;
    set("name", "fom"+num2str(i)+"_mode_exp");
    setexpansion("Output", "fom"+num2str(i));
    set("monitor type", "2D X-normal");
    set("x", size_x/2-0.2e-6);
    set("y", 0.5*opt_size_y-0.5*out_wg_width);
    set("y span", out_wg_width+1e-6);
    set("z",0);
    set("z span",fdtd_zspan);
    set("mode selection","user select");
    set("selected mode numbers",out_mode_list(i));
    set("override global monitor settings",false);
    set("auto update before analysis",true);
}
# getresult("fom1_mode_exp", "expansion for Output") -> output selected mode 1
# getresult("fom2_mode_exp", "expansion for Output") -> output selected mode 2
# Each run uses a single enabled input source, and reads BOTH output spectra.
